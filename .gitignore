# Cargo build tree. Rebuild from starlign/ with cargo.
/starlign/target/

# ONNX Runtime, CUDA, and cuDNN. starlign/dist/lib is a symlink to this directory.
/starlign/runtime/lib/

# Launch binary and dated copies. Larger than jj's snapshot size limit.
/starlign/dist/starlign
/starlign/dist/starlign-*

# MMS weights (CC-BY-NC 4.0). Download on use.
/models/

# Audiobook, EPUBs, and generated emissions. They stay on disk across a restore.
/emission/
*.epub
*.m4b
*.onnx
*.emissions
*.emissions.tracks.json
