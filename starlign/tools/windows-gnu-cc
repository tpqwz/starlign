#!/usr/bin/env python3
"""Link x86_64-pc-windows-gnu with zig's mingw-w64 runtime.

Rustc asks for -lmsvcrt and -nodefaultlibs. Zig 0.17 provides that C runtime
as -lc and does not ship an msvcrt import library under that name.
"""

import os
import shutil
import subprocess
import sys


def zig_bin() -> str:
    env = os.environ.get("STARLIGN_ZIG")
    if env:
        return env
    home = os.path.expanduser("~/.local/opt/zig/zig")
    if os.path.isfile(home):
        return home
    found = shutil.which("zig")
    if found:
        return found
    sys.stderr.write("zig was not found. Set STARLIGN_ZIG to the zig binary.\n")
    raise SystemExit(1)


def expand(argv: list[str]) -> list[str]:
    """Rustc passes a response file when the link line is longer than ARG_MAX."""
    out: list[str] = []
    for arg in argv:
        if len(arg) > 1 and arg.startswith("@") and os.path.isfile(arg[1:]):
            with open(arg[1:], encoding="utf-8", errors="surrogateescape") as handle:
                nested = []
                for line in handle:
                    line = line.strip()
                    if not line:
                        continue
                    if len(line) >= 2 and line[0] == '"' and line[-1] == '"':
                        line = line[1:-1]
                    nested.append(line)
            out.extend(expand(nested))
            continue
        out.append(arg)
    return out


def import_archive(name: str, libdirs: list[str]) -> str | None:
    """windows-sys ships a GNU import library, not a DLL Zig can search for."""
    if not name.startswith("windows."):
        return None
    filename = f"lib{name}.a"
    for directory in libdirs:
        candidate = os.path.join(directory, filename)
        if os.path.isfile(candidate):
            return candidate
    return None


def library_dirs(raw: list[str]) -> list[str]:
    dirs: list[str] = []
    index = 0
    while index < len(raw):
        arg = raw[index]
        if arg == "-L" and index + 1 < len(raw):
            dirs.append(raw[index + 1])
            index += 2
            continue
        if arg.startswith("-L") and len(arg) > 2:
            dirs.append(arg[2:])
        index += 1
    return dirs


def main() -> int:
    raw = expand(sys.argv[1:])
    libdirs = library_dirs(raw)
    args: list[str] = []
    for arg in raw:
        if arg == "-nodefaultlibs" or arg == "-lmsvcrt":
            continue
        if arg == "-l:libpthread.a":
            args.append("-lpthread")
            continue
        if arg.startswith("-l") and not arg.startswith("-l:"):
            archive = import_archive(arg[2:], libdirs)
            if archive:
                args.append(archive)
                continue
        args.append(arg)
    args.append("-lc")
    result = subprocess.run([zig_bin(), "cc", "-target", "x86_64-windows-gnu", *args])
    return result.returncode


if __name__ == "__main__":
    raise SystemExit(main())
